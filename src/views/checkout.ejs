<%- include('partials/header') %><section class="checkout-main"><div class="checkout-heading"><h1>Checkout</h1><p>Enter your Minecraft username and review your order.</p></div><div class="checkout-card"><% const price = pkg ? (product?.pricing?.price_final !== undefined ? money(product.pricing.price_final/100,product.currency) : money(pkg.price,pkg.currency)) : '—'; %><form method="post" action="/checkout"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="package" value="<%= pkg?.id || '' %>"><label class="username-label" for="username">Minecraft username</label><input id="username" name="username" autocomplete="username" minlength="3" maxlength="16" pattern="[A-Za-z0-9_]{3,16}" placeholder="Enter your in-game name" value="<%= customerName %>" <%= customerName ? 'readonly' : '' %> <%= !pkg ? 'disabled' : '' %> required><% if (customerName) { %><button type="submit" class="change-account" form="logout-form">Change account</button><% } %><hr><h2 class="order-label">ORDER SUMMARY</h2><div class="order-item"><div><strong><%= pkg?.name || 'Your order is empty' %></strong><small><%= pkg ? (product?.allow_one_time_purchase && !product?.remove_after_enabled ? 'Permanent rank' : 'Rank package') : 'Choose a rank to get started.' %></small></div><span class="mono"><%= price %></span></div><hr class="order-divider"><% if (product?.allow_subscription) { %><label class="billing-label" for="billing">Purchase option</label><select id="billing" name="subscription"><% if (product.allow_one_time_purchase) { %><option value="false">One time purchase</option><% } %><option value="true">Subscription — every <%= product.subscription_interval_value %> <%= product.subscription_interval_scale %>(s)</option></select><% } %><% (product?.custom_variables || []).forEach(variable => { %><label class="billing-label" for="var_<%= variable.identifier %>"><%= variable.name %></label><% if (variable.type === 'dropdown') { %><select id="var_<%= variable.identifier %>" name="var_<%= variable.identifier %>" required><% variable.options.forEach(option => { %><option value="<%= option.value %>" <%= option.is_default ? 'selected' : '' %>><%= option.name %></option><% }) %></select><% } else { %><input id="var_<%= variable.identifier %>" name="var_<%= variable.identifier %>" type="<%= variable.type === 'number' ? 'number' : 'text' %>" maxlength="256" required><% } %><% }) %><% if (product?.single_game_server_only) { %><label class="billing-label" for="gameserver">Game server</label><select name="gameserver" id="gameserver" required><% (product.gameservers || []).filter(server => server.enabled).forEach(server => { %><option value="<%= server.id %>"><%= server.name %></option><% }) %></select><% } %><div class="order-total"><span>Total</span><strong class="mono"><%= price %></strong></div><% if (error) { %><p class="form-error" role="alert"><%= error === 'auth' ? 'Check your Minecraft username and try again.' : error === 'unavailable' ? 'This purchase option is unavailable. Please contact store support.' : 'Checkout could not be opened. Please try again.' %></p><% } %><% if (pkg && !ready) { %><p class="purchase-note"><%= unavailable ? 'Checkout is temporarily unavailable. Please try again soon.' : 'This rank is not available for purchase yet.' %></p><% } %><% if (product?.vat_rate) { %><p class="purchase-note"><%= product.vat_rate.percentage %>% <%= product.vat_rate.vat_abbreviation %>. Applicable tax is confirmed at payment.</p><% } %><% if (pkg) { %><button type="submit" class="button checkout-button" <%= !ready ? 'disabled' : '' %>>CHECKOUT</button><% } else { %><a href="/ranks" class="button checkout-button">VIEW RANKS</a><% } %></form><% if (customerName) { %><form id="logout-form" method="post" action="/customer/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"></form><% } %></div></section><%- include('partials/footer') %>
