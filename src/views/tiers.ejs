<%- include('partials/header') %>
<section class="tiers-main">
  <div class="tiers-heading">
    <h1>Tiers</h1>
    <nav class="mode-switch" aria-label="Leaderboard category">
      <a href="/tiers?mode=smp-teams" class="<%= mode !== 'pvp' ? 'selected' : '' %>" <%- mode !== 'pvp' ? 'aria-current="page"' : '' %>>SMP</a>
      <a href="/tiers?mode=pvp" class="<%= mode === 'pvp' ? 'selected' : '' %>" <%- mode === 'pvp' ? 'aria-current="page"' : '' %>>PVP</a>
    </nav>
    <% if (mode !== 'pvp' && board.seasons?.length) { %>
      <form class="season-switcher" action="/tiers" method="get">
        <input type="hidden" name="mode" value="<%= mode %>">
        <label for="season-select">SEASON</label>
        <select id="season-select" name="season">
          <% board.seasons.forEach(season => { %>
            <option value="<%= season.id %>" <%= season.id === board.season ? 'selected' : '' %>><%= season.name %><%= season.id === board.currentSeason ? ' · CURRENT' : '' %></option>
          <% }) %>
        </select>
        <button type="submit">VIEW</button>
      </form>
    <% } %>
  </div>
  <% if (mode === 'pvp' && !board.entries.length) { %>
    <div class="pvp-empty"><img src="/assets/design/pvp-icon.svg" alt=""><h2>PVP</h2><p><%= board.unavailable ? 'Rankings temporarily unavailable.' : 'Rankings coming soon.' %></p></div>
  <% } else { %>
    <div class="leaderboard-module">
      <% if (mode !== 'pvp') { %>
        <nav class="connected-tabs" aria-label="SMP leaderboard">
          <a href="/tiers?mode=smp-teams<%= board.season ? '&season=' + encodeURIComponent(board.season) : '' %>" class="<%= mode === 'smp-teams' ? 'selected' : '' %>" <%- mode === 'smp-teams' ? 'aria-current="page"' : '' %>><img src="/assets/design/team-banner.svg" alt=""><span>Team</span></a>
          <a href="/tiers?mode=smp-solo<%= board.season ? '&season=' + encodeURIComponent(board.season) : '' %>" class="<%= mode === 'smp-solo' ? 'selected' : '' %>" <%- mode === 'smp-solo' ? 'aria-current="page"' : '' %>><img src="/assets/design/solo-banner.svg" alt=""><span>Solo</span></a>
        </nav>
      <% } %>
      <div class="leaderboard-body">
        <div class="leaderboard-header"><span># / <%= mode === 'smp-teams' ? 'TEAM' : 'PLAYER' %></span><span>REGION</span><span>POINTS</span></div>
        <% if (!board.entries.length) { %>
          <div class="leaderboard-empty"><h2><%= board.unavailable ? 'Rankings temporarily unavailable.' : 'Rankings coming soon.' %></h2><p><%= board.unavailable ? 'Please try again in a moment.' : 'Standings will appear once points have been recorded.' %></p></div>
        <% } else { %>
          <div class="leaderboard-rows">
            <% board.entries.forEach((entry,index) => { const rank = Number(entry.rank || (page-1)*6+index+1); const name = String(entry.displayName || entry.subjectId || ''); const points = Number(entry.points || 0); const region = String(entry.region || leaderboardRegion || ''); %>
              <div class="leaderboard-row"><span class="position position-<%= rank <= 3 ? rank : 'other' %>">#<%= rank %></span><span class="avatar <%= mode === 'smp-teams' ? 'team-avatar' : 'solo-avatar' %>" aria-hidden="true"><% if (mode === 'smp-solo') { %><img src="<%= entry.portraitUrl || '/assets/design/default-player.svg' %>" width="36" height="54" alt="" loading="<%= index < 2 ? 'eager' : 'lazy' %>" decoding="async" referrerpolicy="no-referrer" data-account-portrait><% } else { %><%= name.slice(0,1).toUpperCase() %><% } %></span><div class="competitor"><strong><%= name %></strong><small><%= entry.tier || tierForPoints(points) %> • <%= points %> points<% if (mode === 'smp-teams' && entry.memberCount !== null && entry.memberCount !== undefined) { %> • <%= entry.memberCount %> members<% } else if (mode === 'smp-solo') { %> • SMP Solo<% } %><% if (entry.prefix) { %> • <%= entry.prefix %><% } %></small></div><span class="region-cell"><% if (region) { %><span class="region-badge"><%= region %></span><% } else { %>—<% } %></span><strong class="points mono"><%= points %></strong></div>
            <% }) %>
          </div>
        <% } %>
      </div>
      <% if (page > 1 || board.hasNext) { %>
        <nav class="pagination" aria-label="Leaderboard pagination">
          <% if (page > 1) { %><a href="/tiers?mode=<%= mode %>&page=<%= page-1 %><%= board.season ? '&season=' + encodeURIComponent(board.season) : '' %>">← Previous</a><% } %>
          <span>Page <%= page %></span>
          <% if (board.hasNext) { %><a href="/tiers?mode=<%= mode %>&page=<%= page+1 %><%= board.season ? '&season=' + encodeURIComponent(board.season) : '' %>">Next →</a><% } %>
        </nav>
      <% } %>
    </div>
  <% } %>
</section>
<%- include('partials/footer') %>
