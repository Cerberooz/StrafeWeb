<%- include('partials/header') %>
<section class="store-main shell">
  <h1>StrafeMC Store</h1>
  <div class="store-info">
    <div><span>SERVER</span><strong class="mono"><%= minecraft %></strong></div>
    <% if (discord) { %>
      <div class="store-discord"><span>DISCORD</span><a href="<%= discord %>" target="_blank" rel="noopener noreferrer">Join our Discord</a></div>
    <% } else { %>
      <div class="store-discord"><span>DISCORD</span><span class="unconfigured-discord">Join our Discord</span></div>
    <% } %>
  </div>
  <hr>
  <h2><%= isRanks ? 'Ranks' : category?.name || 'Ranks' %></h2>
  <% if (isRanks && comparisonPackages.length) { %>
    <div class="comparison-scroll" tabindex="0" role="region" aria-label="Rank comparison table">
      <table class="comparison">
        <thead>
          <tr>
            <th scope="col">PERKS</th>
            <% comparisonPackages.forEach((pkg,index) => { %>
              <th scope="col" class="rank-column rank-color-<%= index % 4 %>">
                <% if (pkg.image) { %>
                  <img class="rank-art" src="<%= pkg.image %>" alt="">
                <% } else { %>
                  <span class="rank-art" aria-hidden="true">✦</span>
                <% } %>
                <strong><%= pkg.name %></strong>
                <small class="mono"><%= money(pkg.price,pkg.currency) %><% if (pkg.monthly) { %><span class="rank-period">/month</span><% } %></small>
                <% if (pkg.checkoutId) { %>
                  <a class="button add-rank" href="/checkout?package=<%= encodeURIComponent(pkg.checkoutId) %>">Purchase Rank</a>
                <% } else { %>
                  <button class="button add-rank" type="button" disabled>Purchase Rank</button>
                <% } %>
              </th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% groups.forEach(group => { %>
            <% if (group.title) { %>
              <tr class="group-row"><th scope="rowgroup" colspan="<%= comparisonPackages.length + 1 %>"><%= group.title %></th></tr>
            <% } %>
            <% group.rows.forEach(row => { %>
              <tr>
                <th scope="row"><%= row.name %></th>
                <% row.values.forEach(value => { %>
                  <td class="rich-content"><%- value %></td>
                <% }) %>
              </tr>
            <% }) %>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else if (packages.length) { %>
    <div class="rank-grid">
      <% packages.forEach((pkg,index) => { %>
        <article class="rank-card rank-color-<%= index % 4 %>">
          <span class="rank-art" aria-hidden="true">✦</span>
          <h3><%= pkg.name %></h3>
          <div class="rich-content"><%- pkg.markup.short %></div>
          <p class="mono"><%= money(pkg.price,pkg.currency) %><% if (pkg.monthly) { %><span class="rank-period">/month</span><% } %></p>
          <a class="button" href="/checkout?package=<%= encodeURIComponent(pkg.id) %>">Purchase Rank</a>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-panel">
      <h3><%= store.unavailable || store.comparisonUnavailable ? 'Ranks temporarily unavailable' : 'Ranks coming soon.' %></h3>
      <p>Check back soon or contact us in Discord.</p>
    </div>
  <% } %>
</section>
<%- include('partials/footer') %>
