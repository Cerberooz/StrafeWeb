<%- include('partials/header') %><section class="shell page-section"><a class="breadcrumb" href="/ranks">← All ranks</a><div class="package-layout"><div class="package-copy"><span class="eyebrow muted">YOUR NEXT UPGRADE</span><h1><%= pkg.name %></h1><div class="rich-content package-short"><%- pkg.markup.short %></div><div class="rich-content package-long"><%- pkg.markup.long %></div></div><aside class="purchase-card"><% if (pkg.image) { %><img src="<%= pkg.image %>" class="product-image" alt="<%= pkg.name %>" loading="lazy"><% } else { %><span class="large-rank-icon" aria-hidden="true">✦</span><% } %><h2><%= pkg.name %></h2><div class="purchase-price"><%= new Intl.NumberFormat('en',{style:'currency',currency:/^[A-Z]{3}$/.test(pkg.currency)?pkg.currency:'USD'}).format(pkg.price) %><span><%= pkg.currency %></span></div><a class="button primary full-width" href="/checkout?package=<%= encodeURIComponent(pkg.id) %>">Continue to checkout ↗</a><p class="purchase-note">Your final price and payment options are confirmed at checkout.</p></aside></div></section><%- include('partials/footer') %>
