NODE_ENV=production
HOST=0.0.0.0
PORT=5020
PUBLIC_BASE_URL=https://store.example.com
# Set to the exact number of trusted reverse proxies; keep 0 for direct connections.
TRUST_PROXY_HOPS=0
COOKIE_SECRET=replace-with-at-least-32-random-characters
MINECRAFT_ADDRESS=play.strafemc.net
# Optional status target override; defaults to MINECRAFT_ADDRESS (including SRV records).
# Uses mcsrvstat.us with a shared five-minute cache. No API key required.
SERVER_STATUS_ADDRESS=
DISCORD_URL=https://discord.gg/your-server
# API credential stays on the SSR server. Grant only leaderboards:read.
# In production, use the API's HTTPS URL; 127.0.0.1 inside Docker is this WebApp container.
API_SERVER_BASE_URL=http://127.0.0.1:5000
API_SERVER_API_KEY=
# Avatar images load from render.crafty.gg; the points API key remains server-side.
PAYNOW_STORE_ID=
PAYNOW_API_KEY=
# Optional custom Discord purchase notifications.
# Secret from a PayNow JSON (v1), Order Completed webhook pointing to /webhooks/paynow.
PAYNOW_WEBHOOK_SECRET=
# Leave empty when both events use the same PayNow webhook/signing secret.
# Optional override only for a separate Discord Linked to Order JSON webhook.
PAYNOW_DISCORD_WEBHOOK_SECRET=
# Bot messages inherit its server nickname, avatar and role color.
# The player's Minecraft head appears inside the embed, not as the bot's avatar.
# Use the application's Bot token, not its OAuth client secret. Keep private.
DISCORD_PURCHASE_BOT_TOKEN=
# Enable Discord Developer Mode, then Copy Channel ID from the target text channel.
DISCORD_PURCHASE_CHANNEL_ID=
# Persist this directory in Docker using a volume mounted at /app/data.
PAYNOW_WEBHOOK_DATA_DIR=./data/paynow-discord
# Optional: select one enabled PayNow payment_goal module when you have several.
# Uses PAYNOW_API_KEY with webstore_read, stats_revenue_read and order_read.
# Progress uses gross revenue and UTC daily/monthly/lifetime windows; cached 30s.
PAYNOW_GOAL_MODULE_ID=
# PayNow product tag slug used to select rank products and comparison columns.
PAYNOW_RANK_TAG=ranks
# Exact HTTPS image hostnames used inside product description/perk markup; optional, comma-separated.
# Leave empty to disable embedded description images. Approved hosts receive visitor IPs.
RANK_IMAGE_HOSTS=
# Optional HTTPS Minecraft screenshots exported from the approved design.
HERO_IMAGE_URL=


