NODE_ENV=production
HOST=0.0.0.0
PORT=5020
PUBLIC_BASE_URL=https://store.example.com
# Set to the exact number of trusted reverse proxies; keep 0 for direct connections.
TRUST_PROXY_HOPS=0
COOKIE_SECRET=replace-with-at-least-32-random-characters
MINECRAFT_ADDRESS=play.strafemc.net
# Optional manually configured status; omit to hide the online count.
SERVER_ONLINE_COUNT=
LEADERBOARD_REGION=AS
# Thresholds inferred from the mockup; configure the actual competitive tiers here.
TIER_THRESHOLDS=[{"min":2600,"label":"Tier 1"},{"min":2250,"label":"Tier 2"},{"min":0,"label":"Tier 3"}]
DISCORD_URL=https://discord.gg/your-server
# API credential stays on the SSR server. Grant only leaderboards:read.
# In production, use the API's HTTPS URL; 127.0.0.1 inside Docker is this WebApp container.
API_SERVER_BASE_URL=http://127.0.0.1:5000
API_SERVER_API_KEY=
# Public HTTPS API origin serving cached account portrait PNGs. Required when
# API_SERVER_BASE_URL is private HTTP; otherwise defaults to its HTTPS origin.
# Match the API server's ACCOUNT_PUBLIC_URL origin. Never use a private address.
API_SERVER_PUBLIC_BASE_URL=
PAYNOW_STORE_ID=
PAYNOW_API_KEY=
PAYNOW_RANK_TAG=ranks
# Tebex remains the source of truth for rank descriptions and comparison columns.
TEBEX_PUBLIC_TOKEN=
RANK_CATEGORY_ID=
# Exact HTTPS image hostnames for description/perk markup; comma-separated, no wildcards.
# Approved hosts receive visitor IPs. Add only hosts your administrators trust.
RANK_IMAGE_HOSTS=dunb17ur4ymx4.cloudfront.net
# When displaying Tebex packages, map package IDs to PayNow product IDs.
PAYNOW_PRODUCT_MAP={}
# Optional HTTPS Minecraft screenshots exported from the approved design.
HERO_IMAGE_URL=


